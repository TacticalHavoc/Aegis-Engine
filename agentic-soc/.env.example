# Agentic SOC Environment Configuration Template
# Copy this file to .env and configure your keys:
# cp .env.example .env

# Google Gemini API Key (Required for live Multi-Agent LLM reasoning)
GEMINI_API_KEY=

# Optional: OpenAI API Key (if testing with OpenAI models)
OPENAI_API_KEY=

# Default LLM Model for Multi-Agent Pipeline
AGENT_MODEL=gemini-3.5-flash-lite
